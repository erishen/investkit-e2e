# InvestKit E2E Tests 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ==================== 核心服务 ====================

# Asset Lens (Python 投资分析系统)
ASSET_LENS_URL=http://localhost:8000

# TS-Demo (TypeScript 投资分析系统)
TS_DEMO_URL=http://localhost:3000

# ==================== 独立项目 ====================

# Solo Chat (AI 聊天助手)
SOLO_CHAT_URL=http://localhost:5173

# Stock Analyzer (股票分析工具)
STOCK_ANALYZER_URL=http://localhost:8001

# Lobster (OpenClaw 龙虾助理 - Streamlit)
LOBSTER_URL=http://localhost:8501

# ==================== 浏览器配置 ====================

# 无头模式 (true/false)
HEADLESS=true

# 录制视频 (true/false)
RECORD_VIDEO=false

# 录制 HAR (true/false)
RECORD_HAR=false

# ==================== 测试配置 ====================

# 默认超时时间 (毫秒)
DEFAULT_TIMEOUT=15000

# 导航超时时间 (毫秒)
NAVIGATION_TIMEOUT=30000

# 重试次数
RETRY_COUNT=2

# 并行工作进程数 (auto/数字)
PARALLEL_WORKERS=auto
